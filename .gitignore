# ---------------------------------------------------------------------------
# PATIENT DATA — never commit. This is a legal obligation under the DPDP Act,
# not a preference. The database, the WAL sidecar files, the backups and any
# consultation audio all contain identifiable health information.
# ---------------------------------------------------------------------------
clinicos-app/data/
**/data/*.db
**/data/*.db-shm
**/data/*.db-wal
**/data/*.db-journal
**/data/audio/
**/data/backups/
*.db
*.db-shm
*.db-wal

# Throwaway databases and logs from `npm run test:e2e`
clinicos-app/.test-data/

# A local copy of the database for clicking around in, so that testing never
# creates accounts or patients in the clinic's real data/ folder.
clinicos-app/.local-test/

# Real clinic identity and any API keys
.env
.env.local
clinicos-app/.env

# Dependencies and build output
node_modules/
.vercel/
.next/
out/
build/
dist/

# Python sidecar: virtualenv and the downloaded Whisper weights (~230 MB)
asr/.venv/
asr/models/
**/__pycache__/
*.pyc

# Logs and runtime scratch
logs/
*.log
*.pid

# Local archives and superseded working copies
_to_delete/
*.zip

# macOS
.DS_Store
.AppleDouble

# The Vercel CLI's link to the `demo` project. `vercel link` also appends `.env*`
# here; that is left out on purpose, because it silently ignores every future
# .env.example, and `.env` / `.env.local` above already cover the real files.
.vercel
