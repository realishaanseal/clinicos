# ---------------------------------------------------------------------------
# ClinicOS local configuration. Copy to .env and edit.
# ---------------------------------------------------------------------------

DB_PATH="./data/clinicos.db"

# Where consultation audio is written before it is deleted at signing.
AUDIO_DIR="./data/audio"

# --- Speech recognition -----------------------------------------------------
# "local"  = the Python sidecar in ./asr. Audio never leaves this machine.
# "http"   = any OpenAI-compatible /audio/transcriptions endpoint.
ASR_PROVIDER="local"
ASR_LOCAL_URL="http://127.0.0.1:8756"
# Leave empty for auto-detect. "bn" forces Bengali; auto usually handles code-mixing better.
ASR_LANGUAGE=""

ASR_HTTP_URL=""
ASR_HTTP_KEY=""
ASR_HTTP_MODEL="whisper-1"

# --- Note generation --------------------------------------------------------
# "ollama" = fully local. Nothing leaves this machine.
# "openai" = any OpenAI-compatible chat completions endpoint.
LLM_PROVIDER="ollama"
LLM_OLLAMA_URL="http://127.0.0.1:11434"
LLM_OLLAMA_MODEL="qwen2.5:7b-instruct"

LLM_OPENAI_URL=""
LLM_OPENAI_KEY=""
LLM_OPENAI_MODEL=""

# --- Clinic details printed on the prescription -----------------------------
CLINIC_NAME="Demo Clinic"
CLINIC_ADDRESS="Krishnanagar, Nadia, West Bengal"
CLINIC_PHONE=""
DOCTOR_NAME="Dr. Demo"
DOCTOR_QUALIFICATION="MBBS"
DOCTOR_REGNO=""
