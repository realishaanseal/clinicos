# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# On Vercel these are set as project environment variables instead.

# Supabase Postgres, Mumbai (ap-south-1).
#
# Use the TRANSACTION POOLER string: Supabase dashboard -> Connect ->
# Transaction pooler. It has pooler.supabase.com and port 6543 in it. The
# direct connection holds a session open per client and runs out of
# connections as soon as this is serverless, so it is the wrong one here.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# 32 random bytes as 64 hex characters, generated on this machine:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Encrypts the shared prescription before it is stored, so the payload is
# ciphertext in the database as well as at rest in Supabase.
PORTAL_ENCRYPTION_KEY=""

# Same length, different key. Phone numbers are stored only as an HMAC, so a
# visit can be matched to a patient without the portal holding any number.
PORTAL_HMAC_KEY=""
