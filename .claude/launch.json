{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "landing"
      ],
      "port": 3001
    },
    {
      "name": "clinic",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "clinicos-app"
      ],
      "port": 3000
    },
    {
      "name": "clinic-sandbox",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:sandbox",
        "--prefix",
        "clinicos-app"
      ],
      "port": 3002
    }
  ]
}
